---
import Layout from "../layouts/Layout.astro";
import { profile, stats, projects } from "../data/site.js";

const catLabel = {
  automation: "automatización",
  dev: "desarrollo",
  other: "creativo",
};
// Dificultad -> cantidad de estrellitas
const diffStars = { "Fácil": 1, "Media": 2, "Difícil": 3, "Boss": 4 };
const visibleSocials = profile.socials.filter((s) => s.url);
---

<Layout title={`${profile.name} · Portafolio`}>
  <!-- ============ NAV ============ -->
  <header class="nav">
    <div class="container nav-inner">
      <a href="#top" class="nav-logo boil">✎ {profile.name.toLowerCase()}</a>
      <nav class="nav-links">
        <a href="#about">ficha</a>
        <a href="#projects">proyectos</a>
        <a href="#contact">contacto</a>
      </nav>
    </div>
  </header>

  <!-- ============ HERO ============ -->
  <section id="top" class="hero">
    <!-- garabatos flotantes -->
    <svg class="floaty f1 draw" style="top:14%;left:8%" viewBox="0 0 100 100" width="70" height="70">
      <path d="M50 8 L70 88 L8 36 L92 36 L30 88 Z" fill="none" stroke="var(--yellow)" stroke-width="4" stroke-linejoin="round"/>
    </svg>
    <svg class="floaty f2 draw" style="top:22%;right:10%" viewBox="0 0 130 80" width="120" height="74">
      <path d="M8 60 C 45 8, 95 8, 122 38 M122 38 L106 24 M122 38 L104 46" fill="none" stroke="var(--teal)" stroke-width="4" stroke-linecap="round"/>
    </svg>
    <svg class="floaty f3 draw" style="bottom:16%;left:14%" viewBox="0 0 90 90" width="80" height="80">
      <path d="M50 30 C 28 30 28 58 50 58 C 78 58 78 20 44 20 C 8 20 8 72 58 72" fill="none" stroke="var(--blue)" stroke-width="4" stroke-linecap="round"/>
    </svg>

    <div class="container hero-inner">
      <p class="hero-kicker reveal">¡hola! soy</p>
      <h1 class="hero-name">{profile.name.toLowerCase()}</h1>
      <svg class="underline-doodle draw" viewBox="0 0 220 20" preserveAspectRatio="none" height="18">
        <path d="M4 13 Q 40 2, 78 11 T 150 10 T 216 9"/>
      </svg>
      <p class="hero-role reveal">{profile.role}</p>
      <div class="sticky-note reveal boil">{profile.tagline}</div>
      <div class="hero-cta reveal">
        <a href="#projects" class="btn">mis proyectos →</a>
        <a href="#contact" class="btn red">¡hablemos!</a>
      </div>
    </div>
    <p class="scroll-hint">↓ bajá ↓</p>
  </section>

  <!-- ============ FICHA / STATS ============ -->
  <section id="about" class="about">
    <div class="container about-grid">
      <div class="about-card sketch-box reveal">
        <span class="tape"></span>
        <div class="about-head">
          <svg class="about-doodle boil" viewBox="0 0 100 100" width="78" height="78">
            <circle cx="50" cy="42" r="26" fill="none" stroke="var(--ink)" stroke-width="3.5"/>
            <path d="M50 8 V 4 M50 68 V 90 M30 90 H 70" fill="none" stroke="var(--ink)" stroke-width="3.5" stroke-linecap="round"/>
            <path d="M40 38 q 10 -12 20 0" fill="none" stroke="var(--yellow)" stroke-width="4" stroke-linecap="round"/>
          </svg>
          <div>
            <p class="about-name">{profile.name.toLowerCase()}</p>
            <p class="about-role-2">{profile.role} · {profile.location}</p>
          </div>
        </div>
        <p class="about-bio">{profile.bio}</p>
      </div>

      <div class="stats sketch-box reveal">
        <span class="tape tape-2"></span>
        <p class="stats-title">★ mis habilidades</p>
        {stats.map((s) => (
          <div class="stat">
            <div class="stat-top">
              <span>{s.label}</span>
            </div>
            <div class="stat-bar">
              <span class="stat-fill" data-value={s.value}></span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ PROYECTOS ============ -->
  <section id="projects" class="projects">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">mi cuaderno de</span>
        <h2>proyectos &amp; automatizaciones</h2>
        <svg class="underline-doodle draw" viewBox="0 0 220 20" preserveAspectRatio="none" height="18">
          <path d="M4 12 Q 50 3, 100 11 T 216 10"/>
        </svg>
      </div>

      <div class="project-grid">
        {projects.map((p, i) => (
          <article class={`project-card sketch-box cat-${p.category} reveal`} style={`--rot:${(i % 2 === 0 ? -1.5 : 1.5)}deg`}>
            <span class="tape"></span>
            <div class="card-top">
              <span class="card-cat">#{catLabel[p.category]}</span>
              <span class="card-diff" title={p.difficulty}>
                {"★".repeat(diffStars[p.difficulty] || 1)}{"☆".repeat(4 - (diffStars[p.difficulty] || 1))}
              </span>
            </div>
            <h3 class="card-title">{p.title}</h3>
            <p class="card-desc">{p.description}</p>
            <div class="card-tags">
              {p.tags.map((t) => <span class="tag">{t}</span>)}
            </div>
            {p.link && (
              <a href={p.link} target="_blank" rel="noopener" class="card-link">ver más →</a>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ CONTACTO ============ -->
  <section id="contact" class="contact">
    <div class="container">
      <div class="contact-card sketch-box reveal">
        <svg class="floaty c-star draw" viewBox="0 0 100 100" width="56" height="56">
          <path d="M50 8 L70 88 L8 36 L92 36 L30 88 Z" fill="none" stroke="var(--red)" stroke-width="4" stroke-linejoin="round"/>
        </svg>
        <span class="eyebrow">¿seguimos?</span>
        <h2>armemos tu próximo proyecto</h2>
        <p class="contact-sub">contame qué tarea te come el tiempo y la convertimos en una automatización ✏️</p>
        <a href={`mailto:${profile.email}`} class="btn teal">✉ {profile.email}</a>
        {visibleSocials.length > 0 && (
          <div class="socials">
            {visibleSocials.map((s) => (
              <a href={s.url} target="_blank" rel="noopener" class="social">{s.label}</a>
            ))}
          </div>
        )}
      </div>
      <p class="foot">dibujado a mano con Astro + GSAP · © {new Date().getFullYear()} {profile.name.toLowerCase()}</p>
    </div>
  </section>
</Layout>

<style>
  /* ---------- NAV ---------- */
  .nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 1000;
    background: rgba(246, 241, 228, 0.85);
    backdrop-filter: blur(4px);
    border-bottom: 2.5px dashed var(--ink);
  }
  .nav-inner { display: flex; align-items: center; justify-content: space-between; height: 62px; }
  .nav-logo { font-size: 24px; font-weight: 800; }
  .nav-links { display: flex; gap: 26px; }
  .nav-links a { font-family: var(--font-note); font-size: 16px; transition: color .2s, transform .2s; }
  .nav-links a:hover { color: var(--red); transform: rotate(-3deg); }

  /* ---------- HERO ---------- */
  .hero { min-height: 100vh; display: flex; align-items: center; text-align: center; padding-top: 62px; }
  .hero-inner { width: 100%; position: relative; z-index: 2; }
  .hero-kicker { font-family: var(--font-note); font-size: 22px; color: var(--ink-soft); transform: rotate(-2deg); }
  .hero-name {
    font-family: var(--font-scribble);
    font-size: clamp(60px, 16vw, 170px);
    line-height: 0.95;
    color: var(--ink);
    margin: 6px 0;
  }
  .hero-role { font-family: var(--font-note); font-size: clamp(18px, 3vw, 26px); color: var(--red); margin-top: 14px; }
  .sticky-note {
    display: inline-block;
    max-width: 460px;
    margin: 26px auto 0;
    padding: 18px 22px;
    background: var(--yellow);
    font-size: 20px;
    transform: rotate(-2deg);
    box-shadow: 4px 5px 0 rgba(44,42,38,.25);
  }
  .hero-cta { display: flex; gap: 20px; justify-content: center; flex-wrap: wrap; margin-top: 34px; }
  .scroll-hint { position: absolute; bottom: 24px; left: 50%; transform: translateX(-50%);
    font-family: var(--font-note); font-size: 16px; color: var(--ink-soft); animation: bob 1.5s ease-in-out infinite; }
  @keyframes bob { 50% { transform: translate(-50%, 9px); } }

  /* doodles flotantes con deriva */
  .floaty.f1 { animation: drift1 7s ease-in-out infinite; }
  .floaty.f2 { animation: drift2 9s ease-in-out infinite; }
  .floaty.f3 { animation: drift1 8s ease-in-out infinite reverse; }
  @keyframes drift1 { 50% { transform: translateY(-16px) rotate(8deg); } }
  @keyframes drift2 { 50% { transform: translateY(14px) rotate(-7deg); } }

  /* ---------- FICHA / STATS ---------- */
  .about-grid { display: grid; grid-template-columns: 1.1fr 1fr; gap: 36px; align-items: start; }
  .about-card, .stats { padding: 32px; }
  .about-head { display: flex; align-items: center; gap: 18px; margin-bottom: 18px; }
  .about-name { font-size: 30px; font-weight: 800; line-height: 1; }
  .about-role-2 { font-family: var(--font-note); font-size: 15px; color: var(--red); }
  .about-bio { font-size: 20px; }
  .stats-title { font-family: var(--font-note); font-size: 20px; color: var(--blue); margin-bottom: 20px; }
  .stat { margin-bottom: 16px; }
  .stat-top { font-weight: 700; margin-bottom: 5px; }
  .stat-bar {
    height: 18px; border: 2.5px solid var(--ink);
    border-radius: 120px 8px 120px 8px / 8px 120px 8px 120px;
    overflow: hidden; background: var(--paper-2);
  }
  .stat-fill { display: block; height: 100%; width: 0; background: var(--teal); }

  /* cinta adhesiva */
  .tape {
    position: absolute; top: -13px; left: 50%; transform: translateX(-50%) rotate(-3deg);
    width: 92px; height: 26px; background: rgba(243, 179, 43, 0.55);
    border-left: 1px dashed rgba(44,42,38,.25); border-right: 1px dashed rgba(44,42,38,.25);
  }
  .tape-2 { background: rgba(31, 179, 163, 0.45); transform: translateX(-50%) rotate(2deg); }

  /* ---------- PROYECTOS ---------- */
  .project-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(310px, 1fr)); gap: 34px 28px; }
  .project-card {
    padding: 26px 24px 24px;
    transform: rotate(var(--rot));
    transition: transform .2s ease, box-shadow .2s ease;
  }
  .project-card:hover { transform: rotate(0deg) translateY(-6px) scale(1.02); box-shadow: 6px 8px 0 rgba(44,42,38,.18); }
  .card-top { display: flex; justify-content: space-between; align-items: center; margin: 6px 0 12px; }
  .card-cat { font-family: var(--font-note); font-size: 15px; color: var(--ink-soft); }
  .cat-automation .card-cat { color: var(--teal); }
  .cat-dev .card-cat { color: var(--blue); }
  .cat-other .card-cat { color: var(--red); }
  .card-diff { color: var(--yellow); font-size: 18px; letter-spacing: 1px; }
  .card-title { font-size: 25px; font-weight: 800; line-height: 1.1; margin-bottom: 10px; }
  .card-desc { font-size: 18px; color: var(--ink); margin-bottom: 16px; }
  .card-tags { display: flex; flex-wrap: wrap; gap: 8px; }
  .tag {
    font-family: var(--font-note); font-size: 13px; padding: 3px 11px;
    border: 2px solid var(--ink);
    border-radius: 90px 8px 90px 8px / 8px 90px 8px 90px;
    background: var(--paper-2);
  }
  .card-link { display: inline-block; margin-top: 14px; font-weight: 800; color: var(--red); }
  .card-link:hover { text-decoration: underline wavy; }

  /* ---------- CONTACTO ---------- */
  .contact { text-align: center; }
  .contact-card { max-width: 680px; margin: 0 auto; padding: 46px 36px; position: relative; }
  .c-star { position: absolute; top: -26px; right: 26px; }
  .contact-card h2 { font-size: clamp(30px, 5vw, 48px); margin: 6px 0 14px; }
  .contact-sub { font-size: 20px; color: var(--ink-soft); max-width: 480px; margin: 0 auto 26px; }
  .socials { display: flex; gap: 22px; justify-content: center; margin-top: 24px; }
  .social { font-family: var(--font-note); font-size: 17px; color: var(--blue); }
  .social:hover { color: var(--red); text-decoration: underline wavy; }
  .foot { text-align: center; margin-top: 48px; font-family: var(--font-note); font-size: 15px; color: var(--ink-soft); }

  @media (max-width: 820px) {
    .about-grid { grid-template-columns: 1fr; }
    .nav-links { gap: 16px; }
    .floaty { display: none; }
  }
</style>
