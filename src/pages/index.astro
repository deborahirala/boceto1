---
import Layout from "../layouts/Layout.astro";
import { profile, stats, projects } from "../data/site.js";

const catLabel = {
  automation: "AUTOMATIZACIÓN",
  dev: "DESARROLLO",
  other: "CREATIVO",
};
const visibleSocials = profile.socials.filter((s) => s.url);
---

<Layout title={`${profile.name} · Portafolio`}>
  <!-- ====================== HUD / NAV ====================== -->
  <header class="hud">
    <div class="container hud-inner">
      <a href="#top" class="hud-logo">◉ {profile.name}</a>
      <nav class="hud-nav">
        <a href="#about">PERFIL</a>
        <a href="#projects">MISIONES</a>
        <a href="#contact">CONTACTO</a>
      </nav>
    </div>
  </header>

  <!-- ====================== HERO ====================== -->
  <section id="top" class="hero">
    <div class="container hero-inner">
      <p class="hero-tag reveal">▸ PLAYER 1 · {profile.role}</p>
      <h1 class="hero-name glitch reveal" data-text={profile.name}>{profile.name}</h1>
      <p class="hero-sub reveal">{profile.tagline}</p>
      <div class="hero-cta reveal">
        <a href="#projects" class="btn">► Ver misiones</a>
        <a href="#contact" class="btn magenta">Insert coin</a>
      </div>
    </div>
    <div class="scroll-hint">▼ SCROLL</div>
  </section>

  <!-- ====================== PERFIL / STATS ====================== -->
  <section id="about" class="about">
    <div class="container about-grid">
      <div class="about-card reveal">
        <div class="about-card-head">
          <span class="avatar">🎮</span>
          <div>
            <p class="about-name">{profile.name}</p>
            <p class="about-role">{profile.role} · {profile.location}</p>
          </div>
        </div>
        <p class="about-bio">{profile.bio}</p>
      </div>

      <div class="stats reveal">
        <p class="stats-title">⚡ STATS</p>
        {stats.map((s) => (
          <div class="stat">
            <div class="stat-top">
              <span>{s.label}</span>
              <span class="stat-num">LV {Math.round(s.value / 10)}</span>
            </div>
            <div class="stat-bar">
              <span class="stat-fill" data-value={s.value}></span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ====================== PROYECTOS ====================== -->
  <section id="projects" class="projects">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">SELECT MISSION</span>
        <h2>Proyectos & Automatizaciones</h2>
      </div>
      <div class="project-grid">
        {projects.map((p) => (
          <article class={`project-card cat-${p.category} reveal`}>
            <div class="card-top">
              <span class="card-cat">{catLabel[p.category]}</span>
              <span class="card-diff">{p.difficulty}</span>
            </div>
            <h3 class="card-title">{p.title}</h3>
            <p class="card-desc">{p.description}</p>
            <div class="card-tags">
              {p.tags.map((t) => <span class="tag">{t}</span>)}
            </div>
            {p.link && (
              <a href={p.link} target="_blank" rel="noopener" class="card-link">
                JUGAR ►
              </a>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ====================== CONTACTO ====================== -->
  <section id="contact" class="contact">
    <div class="container contact-inner reveal">
      <span class="eyebrow" style="color:var(--green)">GAME OVER? NO.</span>
      <h2>¿Armamos tu próximo nivel?</h2>
      <p class="contact-sub">
        Contame qué tarea te está comiendo el tiempo y la convertimos en una automatización.
      </p>
      <a href={`mailto:${profile.email}`} class="btn">✉ {profile.email}</a>
      {visibleSocials.length > 0 && (
        <div class="socials">
          {visibleSocials.map((s) => (
            <a href={s.url} target="_blank" rel="noopener" class="social">{s.label}</a>
          ))}
        </div>
      )}
    </div>
    <footer class="foot">
      <p>© {new Date().getFullYear()} {profile.name} · Hecho con Astro + GSAP</p>
    </footer>
  </section>
</Layout>

<style>
  /* ---------------- HUD ---------------- */
  .hud {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 1000;
    backdrop-filter: blur(8px);
    background: rgba(7, 7, 15, 0.6);
    border-bottom: 1px solid rgba(0, 240, 255, 0.2);
  }
  .hud-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
  }
  .hud-logo {
    font-family: var(--font-pixel);
    font-size: 13px;
    color: var(--cyan);
    text-shadow: 0 0 10px var(--cyan);
  }
  .hud-nav { display: flex; gap: 28px; }
  .hud-nav a {
    font-family: var(--font-pixel);
    font-size: 10px;
    color: var(--text-dim);
    letter-spacing: 1px;
    transition: color .2s;
  }
  .hud-nav a:hover { color: var(--magenta); }

  /* ---------------- HERO ---------------- */
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    text-align: center;
    padding-top: 64px;
  }
  .hero-inner { width: 100%; }
  .hero-tag {
    font-family: var(--font-pixel);
    font-size: 12px;
    color: var(--green);
    letter-spacing: 2px;
    margin-bottom: 26px;
  }
  .hero-name {
    font-size: clamp(40px, 12vw, 120px);
    line-height: 1;
    margin-bottom: 28px;
    text-shadow: 0 0 30px rgba(0, 240, 255, 0.5);
  }
  .hero-sub {
    max-width: 620px;
    margin: 0 auto 40px;
    font-size: clamp(18px, 2.5vw, 24px);
    color: var(--text-dim);
  }
  .hero-cta { display: flex; gap: 18px; justify-content: center; flex-wrap: wrap; }
  .scroll-hint {
    position: absolute;
    bottom: 30px; left: 50%;
    transform: translateX(-50%);
    font-family: var(--font-pixel);
    font-size: 10px;
    color: var(--cyan);
    animation: bob 1.4s ease-in-out infinite;
  }
  @keyframes bob { 50% { transform: translate(-50%, 10px); } }

  /* ---------------- ABOUT / STATS ---------------- */
  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: stretch;
  }
  .about-card, .stats {
    background: var(--panel);
    border: 1px solid rgba(0, 240, 255, 0.2);
    border-radius: 4px;
    padding: 34px;
    backdrop-filter: blur(6px);
  }
  .about-card-head { display: flex; align-items: center; gap: 18px; margin-bottom: 22px; }
  .avatar {
    font-size: 38px;
    width: 70px; height: 70px;
    display: grid; place-items: center;
    border: 2px solid var(--magenta);
    border-radius: 4px;
    box-shadow: 0 0 18px rgba(255, 46, 136, 0.4);
  }
  .about-name { font-family: var(--font-pixel); font-size: 16px; color: var(--text); }
  .about-role { color: var(--text-dim); font-size: 16px; }
  .about-bio { font-size: 19px; color: var(--text); }
  .stats-title { font-family: var(--font-pixel); font-size: 14px; color: var(--yellow); margin-bottom: 24px; }
  .stat { margin-bottom: 18px; }
  .stat-top { display: flex; justify-content: space-between; font-weight: 600; margin-bottom: 6px; }
  .stat-num { font-family: var(--font-pixel); font-size: 10px; color: var(--cyan); }
  .stat-bar { height: 12px; background: rgba(255,255,255,0.06); border: 1px solid rgba(0,240,255,0.25); }
  .stat-fill {
    display: block; height: 100%; width: 0;
    background: linear-gradient(90deg, var(--cyan), var(--magenta));
    box-shadow: 0 0 10px var(--cyan);
  }

  /* ---------------- PROYECTOS ---------------- */
  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 26px;
  }
  .project-card {
    background: var(--panel);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 4px;
    padding: 28px;
    position: relative;
    overflow: hidden;
    transition: transform .25s ease, border-color .25s ease, box-shadow .25s ease;
    backdrop-filter: blur(6px);
  }
  .project-card::after {
    content: "";
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 3px;
    background: var(--cyan);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform .3s ease;
  }
  .project-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 14px 40px rgba(0, 240, 255, 0.18);
  }
  .project-card:hover::after { transform: scaleX(1); }
  .cat-automation { border-color: rgba(0,240,255,0.35); }
  .cat-automation::after { background: var(--cyan); }
  .cat-dev { border-color: rgba(157,78,221,0.45); }
  .cat-dev::after { background: var(--purple); }
  .cat-other { border-color: rgba(255,46,136,0.4); }
  .cat-other::after { background: var(--magenta); }

  .card-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 18px; }
  .card-cat { font-family: var(--font-pixel); font-size: 8px; letter-spacing: 1px; color: var(--cyan); }
  .cat-dev .card-cat { color: var(--purple); }
  .cat-other .card-cat { color: var(--magenta); }
  .card-diff {
    font-family: var(--font-pixel);
    font-size: 8px;
    padding: 5px 9px;
    border: 1px solid var(--yellow);
    color: var(--yellow);
  }
  .card-title { font-size: 16px; color: var(--text); margin-bottom: 14px; line-height: 1.4; }
  .card-desc { color: var(--text-dim); font-size: 17px; margin-bottom: 18px; }
  .card-tags { display: flex; flex-wrap: wrap; gap: 8px; }
  .tag {
    font-size: 13px;
    font-weight: 600;
    padding: 4px 10px;
    background: rgba(0,240,255,0.08);
    border: 1px solid rgba(0,240,255,0.2);
    color: var(--cyan);
    border-radius: 2px;
  }
  .card-link {
    display: inline-block;
    margin-top: 18px;
    font-family: var(--font-pixel);
    font-size: 10px;
    color: var(--green);
  }
  .card-link:hover { text-shadow: 0 0 10px var(--green); }

  /* ---------------- CONTACTO ---------------- */
  .contact { text-align: center; }
  .contact-inner h2 {
    font-size: clamp(22px, 5vw, 40px);
    margin: 16px 0 18px;
    text-shadow: 0 0 20px rgba(57,255,20,0.4);
  }
  .contact-sub { color: var(--text-dim); max-width: 560px; margin: 0 auto 34px; font-size: 20px; }
  .socials { display: flex; gap: 22px; justify-content: center; margin-top: 30px; }
  .social {
    font-family: var(--font-pixel);
    font-size: 11px;
    color: var(--text-dim);
    border-bottom: 2px solid transparent;
    padding-bottom: 4px;
    transition: color .2s, border-color .2s;
  }
  .social:hover { color: var(--cyan); border-color: var(--cyan); }
  .foot {
    margin-top: 80px;
    padding-top: 30px;
    border-top: 1px solid rgba(255,255,255,0.08);
    color: var(--text-dim);
    font-size: 14px;
  }

  @media (max-width: 820px) {
    .about-grid { grid-template-columns: 1fr; }
    .hud-nav { gap: 16px; }
    .hud-nav a { font-size: 9px; }
  }
</style>
