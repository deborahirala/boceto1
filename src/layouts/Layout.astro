---
import "../styles/global.css";
const { title = "Portafolio" } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Portafolio de proyectos y automatizaciones, dibujado a mano." />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}/favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Gloria+Hallelujah&family=Rubik+Scribble&family=Shantell+Sans:ital,wght@0,300..800;1,300..800&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body>
    <!-- Filtros SVG para el efecto "dibujado a mano" + hervido -->
    <svg width="0" height="0" style="position:absolute" aria-hidden="true">
      <filter id="sk1">
        <feTurbulence type="fractalNoise" baseFrequency="0.018" numOctaves="3" seed="2" result="n" />
        <feDisplacementMap in="SourceGraphic" in2="n" scale="3" />
      </filter>
      <filter id="sk2">
        <feTurbulence type="fractalNoise" baseFrequency="0.018" numOctaves="3" seed="8" result="n" />
        <feDisplacementMap in="SourceGraphic" in2="n" scale="3" />
      </filter>
      <filter id="sk3">
        <feTurbulence type="fractalNoise" baseFrequency="0.018" numOctaves="3" seed="14" result="n" />
        <feDisplacementMap in="SourceGraphic" in2="n" scale="3" />
      </filter>
    </svg>

    <!-- Pantalla de carga estilo boceto -->
    <div id="loader">
      <div class="loader-inner">
        <svg class="loader-pencil boil" viewBox="0 0 200 60" width="200" height="60">
          <path id="loader-path" d="M10 40 Q 40 8, 70 40 T 130 40 T 190 38" />
        </svg>
        <p class="loader-text">dibujando<span class="dots">...</span></p>
      </div>
    </div>

    <!-- Cursor -->
    <div class="cursor-dot"></div>
    <div class="cursor-ring boil"></div>

    <slot />

    <style>
      #loader {
        position: fixed; inset: 0; z-index: 99999;
        background: var(--paper);
        display: flex; align-items: center; justify-content: center;
        transition: opacity 0.6s ease, visibility 0.6s ease;
      }
      #loader.done { opacity: 0; visibility: hidden; }
      .loader-inner { text-align: center; }
      .loader-pencil { overflow: visible; }
      .loader-pencil path {
        fill: none; stroke: var(--ink); stroke-width: 4; stroke-linecap: round;
      }
      .loader-text { font-family: var(--font-note); font-size: 22px; margin-top: 10px; }
      .dots { animation: dots 1.2s steps(4, end) infinite; }
      @keyframes dots { 0% { opacity: .2 } 50% { opacity: 1 } 100% { opacity: .2 } }
    </style>

    <script>
      import { gsap } from "gsap";
      import { ScrollTrigger } from "gsap/ScrollTrigger";
      gsap.registerPlugin(ScrollTrigger);

      /* ===== Helper: preparar un path para "dibujarse" ===== */
      function prep(path) {
        const len = path.getTotalLength();
        path.style.strokeDasharray = String(len);
        path.style.strokeDashoffset = String(len);
        return len;
      }

      /* ===== LOADER (el lápiz dibuja la línea) ===== */
      const loader = document.getElementById("loader");
      const lp = document.getElementById("loader-path");
      if (lp) {
        prep(lp);
        gsap.to(lp, {
          strokeDashoffset: 0,
          duration: 1.1,
          ease: "power1.inOut",
          onComplete: () => {
            setTimeout(() => { loader?.classList.add("done"); startReveals(); }, 250);
          },
        });
      }

      /* ===== CURSOR ===== */
      const dot = document.querySelector(".cursor-dot");
      const ring = document.querySelector(".cursor-ring");
      let mx = 0, my = 0, rx = 0, ry = 0;
      window.addEventListener("mousemove", (e) => {
        mx = e.clientX; my = e.clientY;
        if (dot) { dot.style.left = mx + "px"; dot.style.top = my + "px"; }
      });
      (function loop() {
        rx += (mx - rx) * 0.2; ry += (my - ry) * 0.2;
        if (ring) { ring.style.left = rx + "px"; ring.style.top = ry + "px"; }
        requestAnimationFrame(loop);
      })();
      const setHover = (on) => () => ring?.classList.toggle("hover", on);
      document.querySelectorAll("a, button, .btn, .project-card").forEach((el) => {
        el.addEventListener("mouseenter", setHover(true));
        el.addEventListener("mouseleave", setHover(false));
      });

      /* ===== REVEALS + DIBUJADO DE TRAZOS AL SCROLL ===== */
      let started = false;
      function startReveals() {
        if (started) return;
        started = true;

        gsap.utils.toArray(".reveal").forEach((el) => {
          gsap.to(el, {
            opacity: 1, y: 0, rotate: 0,
            duration: 0.7, ease: "back.out(1.4)",
            scrollTrigger: { trigger: el, start: "top 88%" },
          });
        });

        // Trazos que se dibujan solos (estrellas, flechas, subrayados…)
        gsap.utils.toArray(".draw path").forEach((path) => {
          prep(path);
          gsap.to(path, {
            strokeDashoffset: 0,
            duration: 1,
            ease: "power1.inOut",
            scrollTrigger: { trigger: path, start: "top 90%" },
          });
        });

        // Barras de stats (rellenado a mano)
        gsap.utils.toArray(".stat-fill").forEach((el) => {
          gsap.to(el, {
            width: el.getAttribute("data-value") + "%",
            duration: 1.1, ease: "power2.out",
            scrollTrigger: { trigger: el, start: "top 92%" },
          });
        });
      }
      // Respaldo por si el loader no dispara
      window.addEventListener("load", () => setTimeout(startReveals, 2200));
    </script>
  </body>
</html>
